# CONFIG_USB_STORAGE_ISD200 is not set
# CONFIG_USB_STORAGE_JUMPSHOT is not set
# CONFIG_USB_STORAGE_KARMA is not set
# CONFIG_USB_STORAGE_ONETOUCH is not set
# CONFIG_USB_STORAGE_REALTEK is not set
# CONFIG_USB_STORAGE_SDDR09 is not set
# CONFIG_USB_STORAGE_SDDR55 is not set
# CONFIG_USB_STORAGE_USBAT is not set

# --- platform core (5.4 blair QGKI) ---
# SMMU/IOMMU, WALT scheduler, ZRAM, memlat/L3 scaling, LLCC
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_SECURE_BUFFER=y
CONFIG_SCHED_WALT=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_QCOM_MEMLAT=y
CONFIG_ARM_MEMLAT_MON=y
CONFIG_DEVFREQ_GOV_MEMLAT=y
CONFIG_DEVFREQ_GOV_QCOM_BW_HWMON=y
CONFIG_QCOM_BWMON=y
CONFIG_QCOM_BIMC_BWMON=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_LLCC_PMU=y

# GPU: KGSL with the msm-adreno-tz governor (built in on 5.4)
CONFIG_QCOM_KGSL=y
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y
CONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR="msm-adreno-tz"
# CONFIG_QCOM_KGSL_CORESIGHT is not set
CONFIG_QCOM_KGSL_IOCOHERENCY_DEFAULT=y
CONFIG_QCOM_KGSL_IDLE_TIMEOUT=80
CONFIG_QCOM_KGSL_SORT_POOL=y

# Charger: holi charges through PM7250B SMB5 + QG, not pmic_glink
CONFIG_QPNP_SMB5=y
CONFIG_QPNP_QG=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QPNP_ADAPTIVE_CHARGE=y

# PMIC LEDs/vibrator, WL2864C camera rails, FSA4480 USB switch
CONFIG_LEDS_QPNP_FLASH_V2=y
CONFIG_LEDS_QPNP_VIBRATOR_LDO=y
CONFIG_LEDS_QTI_TRI_LED=y
CONFIG_REGULATOR_WL2864C=y
CONFIG_QCOM_FSA4480_I2C=y

# UFS: in-tree QTI UFS + blair QMP v4 PHY
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_UFS=y
CONFIG_PHY_QCOM_UFS_V4=y
CONFIG_PHY_QCOM_UFS_V4_BLAIR=y

# I2C/SPI GENI + GPI DMA (touch, sensors, PMIC peripherals)
CONFIG_I2C_MSM_GENI=y
CONFIG_SPI_MSM_GENI=y
CONFIG_MSM_GPI_DMA=y
CONFIG_I2C_CHARDEV=y

# Wireless core: RFKILL must be built in, otherwise CFG80211/MAC80211/NFC
# are capped at "=m" and would be missing from an Image-only build
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# --- Motorola / fogos (5.4 moto-holi-fogos + lineage_moto-holi) ---
CONFIG_MMI_ANNOTATE=y
CONFIG_MMI_INFO=y
CONFIG_MMI_RELAY=y
CONFIG_MMI_SYS_TEMP=y
CONFIG_MOTO_UTAGS=y
CONFIG_SENSORS_CLASS=y
CONFIG_SARSENSOR_SX937X=y
CONFIG_NFC=y
CONFIG_BOARD_USES_DOUBLE_TAP_CTRL=y

# Camera: enabled together with the blair camera techpack port
# (CONFIG_AF_NOISE_ELIMINATION / CONFIG_CAM_SENSOR_PROBE_RETRY live inside
# CONFIG_QTI_CAMERA, which the techpack port turns on).

# Display: LCDB is not used on fogos (panels are powered from WL2864C)
# CONFIG_REGULATOR_QPNP_LCDB is not set
# The blair panel is driven by the techpack SDE 6.6.0/DSI 2.4 blocks with the
# 10nm DSI PLL, feature set from techpack/display/config/blairdisp.conf.
CONFIG_QTI_DISPLAY_BLAIR=y

# Lineage: exfat, ZRAM writeback, no pstore deflate
CONFIG_EXFAT_FS=y
# CONFIG_THERMAL_STATISTICS is not set
# CONFIG_PSTORE_DEFLATE_COMPRESS is not set
