# fogos (SM6375/blair) on top of gki_defconfig.
#
# Everything fogos needs is built in (=y) and no modules are shipped, the same
# model as tundra.config. The blair/holi peripheral list below comes from
# arch/arm64/configs/vendor/blair_GKI.config (the QCOM GKI fragment for this
# platform) with every "=m" turned into "=y", plus the platform options the
# 5.4 blair QGKI build enabled and the Moto/Lineage fogos fragments:
#
#   arch/arm64/configs/vendor/ext_config/moto-holi-fogos.config
#   arch/arm64/configs/vendor/ext_config/lineage_moto-holi.config
#
# from android_kernel_motorola_sm6375 lineage-24.0. Options whose drivers are
# not in this tree yet (fogos touchscreen, fingerprint, NFC, charger IIO,
# vibrator, FM, WLAN ICNSS2 and the audio FS1815) are added by the commits
# that port those drivers.
CONFIG_LOCALVERSION="-android14-11-fogos"

# GKI's built-in cmdline enables pKVM, ioremap_guard and bootconfig, none of
# which apply here: blair boots under QHEE and the bootloader supplies the real
# cmdline. Keep only the bring-up aids.
CONFIG_CMDLINE="loglevel=8 ignore_loglevel printk.devkmsg=on panic=5 fw_devlink=permissive clk_ignore_unused pd_ignore_unused regulator_ignore_unused deferred_probe_timeout=30"
CONFIG_CMDLINE_EXTEND=y

# Faster bring-up builds
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set

# gki_defconfig enables the UAPI header self-test. The vendor camera headers
# under usr/include/camera/media are not standalone-compilable: they expect
# media/cam_defs.h on the include path and rely on the kernel's uint32_t /
# struct timespec typedefs, so the test can only fail.
# CONFIG_UAPI_HEADER_TEST is not set

# Gunyah (enabled by gki_defconfig) is not used on blair.
# CONFIG_GUNYAH is not set

# blair_GKI.config with every "=m" turned into "=y".
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG=y
# CONFIG_ARM_QCOM_CPUFREQ_NVMEM is not set
CONFIG_ARM_SMMU=y
CONFIG_CFG80211=y
CONFIG_CHR_DEV_SG=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_CORESIGHT=y
CONFIG_CORESIGHT_CSR=y
CONFIG_CORESIGHT_CTI=y
CONFIG_CORESIGHT_DUMMY=y
CONFIG_CORESIGHT_HWEVENT=y
CONFIG_CORESIGHT_LINKS_AND_SINKS=y
CONFIG_CORESIGHT_LINK_AND_SINK_TMC=y
CONFIG_CORESIGHT_REMOTE_ETM=y
CONFIG_CORESIGHT_STM=y
CONFIG_CORESIGHT_TGU=y
CONFIG_CORESIGHT_TPDA=y
CONFIG_CORESIGHT_TPDM=y
CONFIG_CPU_IDLE_GOV_QCOM_LPM=y
CONFIG_EDAC_KRYO_ARM64=y
# CONFIG_EDAC_KRYO_ARM64_PANIC_ON_UE is not set
# CONFIG_GIC_INTERRUPT_ROUTING is not set
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_I2C_MSM_GENI=y
CONFIG_I3C_MASTER_MSM_GENI=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_QPNP_POWER_ON=y
CONFIG_INTERCONNECT_QCOM_BLAIR=y
CONFIG_INTERCONNECT_QCOM_DEBUG=y
CONFIG_INTERCONNECT_QCOM_HOLI=y
CONFIG_INTERCONNECT_QCOM_QOS_RPM=y
CONFIG_INTERCONNECT_QCOM_RPM=y
CONFIG_INTERCONNECT_TEST=y
CONFIG_IOMMU_IO_PGTABLE_FAST=y
# CONFIG_IOMMU_IO_PGTABLE_FAST_PROVE_TLB is not set
# CONFIG_IOMMU_IO_PGTABLE_FAST_SELFTEST is not set
CONFIG_IPA3=y
CONFIG_IPC_LOGGING=y
CONFIG_IPC_LOG_MINIDUMP_BUFFERS=16
CONFIG_LEDS_AW2016=y
CONFIG_LEDS_QPNP_FLASH_V2=y
CONFIG_LEDS_QPNP_VIBRATOR_LDO=y
CONFIG_LEDS_QTI_TRI_LED=y
CONFIG_MAC80211=y
CONFIG_MEM_SHARE_QMI_SERVICE=y
CONFIG_MFD_I2C_PMIC=y
CONFIG_MFD_SPMI_PMIC=y
# CONFIG_MHI_BUS is not set
CONFIG_MINIDUMP_MAX_ENTRIES=200
CONFIG_MMC_CRYPTO_QTI=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_SDHCI_MSM_SCALING=y
